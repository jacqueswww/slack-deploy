# Web interface. Binds to loopback by default; reach it over an SSH forward, or pass
# --host 0.0.0.0 --tls-cert /etc/slack-deploy/cert.pem --tls-key /etc/slack-deploy/key.pem
# and add /etc/slack-deploy to ReadOnlyPaths. Needs no password at start.
[Unit]
Description=slack-deploy web interface
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=slack-deploy
Group=slack-deploy
WorkingDirectory=/opt/slack-deploy
Environment=SLACK_DEPLOY_DATA=/var/lib/slack-deploy/data
Environment=HOME=/var/lib/slack-deploy
Environment=ANSIBLE_LOCAL_TEMP=/tmp/ansible
Environment=ANSIBLE_SSH_CONTROL_PATH_DIR=/tmp/ansible/cp
ExecStart=/opt/slack-deploy/venv/bin/python /opt/slack-deploy/manage.py web --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

ProtectSystem=strict
ReadWritePaths=/var/lib/slack-deploy /srv/ansible
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
LimitCORE=0
LimitMEMLOCK=64M
UMask=0077

[Install]
WantedBy=multi-user.target
