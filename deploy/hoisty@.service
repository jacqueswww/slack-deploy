# One unit for both daemons: hoisty@bot and hoisty@web. Installed by the .deb.
#
#   systemctl enable --now hoisty@bot hoisty@web
#   hoisty unlock            # as root, once per boot: hands over the password
#   systemd-analyze security hoisty@bot
#
# Both start *locked* and stay inert until `hoisty unlock` gives them the global
# password over their root-only socket in /run/hoisty. There is deliberately no
# console prompt and nothing on disk that could become the key, which is why a
# reboot leaves the units running but idle rather than failed.
#
# The whole install lives under /var/lib/hoisty:
#   app/ venv/            the program, root-owned, read-only to this service
#   data/ backups/        the encrypted store and its backups, hoisty-owned
#   projects/             ansible checkouts, hoisty-owned
#
# For a network bind on the web instance, drop in
#   /etc/systemd/system/hoisty@web.service.d/tls.conf
#     [Service]
#     ExecStart=
#     ExecStart=/usr/bin/hoisty web --host 0.0.0.0 \
#       --tls-cert /etc/hoisty/cert.pem --tls-key /etc/hoisty/key.pem
#     ReadOnlyPaths=/etc/hoisty
# The empty ExecStart= is required: without it systemd refuses to load the unit,
# because Type=notify allows only one.
[Unit]
Description=hoisty %i
Documentation=file:///var/lib/hoisty/app/README.md
After=network-online.target
Wants=network-online.target

[Service]
# notify, so `systemctl status` says "locked" rather than leaving an operator
# guessing why nothing is happening
Type=notify
NotifyAccess=main
User=hoisty
Group=hoisty
WorkingDirectory=/var/lib/hoisty
Environment=HOISTY_DATA=/var/lib/hoisty/data
Environment=HOISTY_RUNTIME=/run/hoisty
Environment=HOME=/var/lib/hoisty
Environment=ANSIBLE_LOCAL_TEMP=/tmp/ansible
Environment=ANSIBLE_SSH_CONTROL_PATH_DIR=/tmp/ansible/cp
ExecStart=/usr/bin/hoisty %i
Restart=on-failure
RestartSec=10
# the unlock socket: 0700 and owned by this service, removed when it stops
RuntimeDirectory=hoisty
RuntimeDirectoryMode=0700

# --- what a compromised playbook, running as this uid, may no longer do ---
# ProtectSystem=strict makes the whole hierarchy read-only; only the three paths
# below are writable. app/ and venv/ therefore stay read-only to this service
# even though they sit under /var/lib/hoisty, so a deploy that goes bad cannot
# rewrite the program that is next handed the password. ~/.ssh is read-only for
# the same reason: it is the known_hosts fallback for every unpinned host.
ProtectSystem=strict
ReadWritePaths=/var/lib/hoisty/data /var/lib/hoisty/backups /var/lib/hoisty/projects
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# keep the key and the plaintext vars out of any core file or swap
LimitCORE=0
LimitMEMLOCK=64M
UMask=0077

[Install]
WantedBy=multi-user.target
