# One unit for both daemons: slack-deploy@bot and slack-deploy@web.
#   cp deploy/slack-deploy@.service /etc/systemd/system/
#   cp -r deploy/slack-deploy@bot.service.d /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now slack-deploy@bot slack-deploy@web
#   systemd-analyze security slack-deploy@bot
# The bot prompts for the global password on tty12 at start (see the drop-in).
# The web daemon binds 127.0.0.1:8080. For a network bind, drop in
#   /etc/systemd/system/slack-deploy@web.service.d/tls.conf
#     [Service]
#     ExecStart=
#     ExecStart=/opt/slack-deploy/venv/bin/python /opt/slack-deploy/manage.py web \
#       --host 0.0.0.0 --tls-cert /etc/slack-deploy/cert.pem --tls-key /etc/slack-deploy/key.pem
#     ReadOnlyPaths=/etc/slack-deploy
# The empty ExecStart= is required: without it systemd refuses to load the unit,
# because Type=exec allows only one.
#
# Layout this unit assumes (change the paths, keep the ownership):
#   /opt/slack-deploy            the checkout and venv, owned by root, mode 755
#   /var/lib/slack-deploy/data   owned by slack-deploy, mode 700
#   /var/lib/slack-deploy/backups                        700
#   /srv/ansible                 project checkouts, owned by slack-deploy
[Unit]
Description=slack-deploy %i
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=slack-deploy
Group=slack-deploy
WorkingDirectory=/opt/slack-deploy
Environment=SLACK_DEPLOY_DATA=/var/lib/slack-deploy/data
Environment=HOME=/var/lib/slack-deploy
Environment=ANSIBLE_LOCAL_TEMP=/tmp/ansible
Environment=ANSIBLE_SSH_CONTROL_PATH_DIR=/tmp/ansible/cp
ExecStart=/opt/slack-deploy/venv/bin/python /opt/slack-deploy/manage.py %i
Restart=on-failure
RestartSec=10

# --- what a compromised playbook, running as this uid, may no longer do ---
# Only these paths are writable. The code and the venv are not: a hostile deploy
# cannot trojan the program that is next handed the passphrase.
ProtectSystem=strict
ReadWritePaths=/var/lib/slack-deploy /srv/ansible
# HOME is inside the writable path above, so carve the ssh config back out: a
# playbook running as this uid could otherwise append its own host key and defeat
# the known_hosts fallback for every host with no pin. Leading - : may not exist.
ReadOnlyPaths=-/var/lib/slack-deploy/.ssh
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# keep the key and the plaintext vars out of any core file or swap
LimitCORE=0
LimitMEMLOCK=64M
UMask=0077

[Install]
WantedBy=multi-user.target
